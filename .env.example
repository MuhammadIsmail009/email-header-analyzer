# Copy to .env and edit. .env is gitignored and must never be committed.
#
# The application runs with none of this set. Without API keys it performs full local
# analysis and reports every provider as DISABLED — it does not invent results.

# -- Application ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# -- Trust boundary ---------------------------------------------------------
# Which infrastructure's Authentication-Results headers may be believed.
#
# RFC 8601 §7.1 warns these headers are forgeable: an attacker can place
#   Authentication-Results: yourcompany.com; spf=pass; dkim=pass; dmarc=pass
# into a message they send, and a tool that reads it uncritically shows a green PASS.
#
# Leaving these empty is safe, not broken — every asserted result is then marked
# UNKNOWN trust. Set them to your own mail infrastructure.
TRUSTED_RECEIVER_DOMAINS=
TRUSTED_RECEIVER_HOSTS=

# -- Independent verification ----------------------------------------------
# Live DNS checks of SPF, DKIM and DMARC. This is what separates "independently
# verified" from "the receiving server claimed". Set false for a fully air-gapped run.
VERIFICATION_ENABLED=true
DNS_RESOLVERS=8.8.8.8,1.1.1.1
DNS_TIMEOUT_SECONDS=3.0
DNSBL_ENABLED=true
DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net,b.barracudacentral.org

# -- Threat-intelligence enrichment ----------------------------------------
# OFF BY DEFAULT, on purpose.
#
# Enabling this sends extracted indicators to third parties. Phishing URLs are often
# unique per recipient, so submitting one to a public scanner can tell the attacker
# their campaign was detected. Turn it on deliberately, not by inheriting a default.
ENRICHMENT_ENABLED=false

# Deterministic fixture data for the bundled samples only. Always labelled
# "Demo Fixture" on screen and in exports. A custom indicator with no key returns
# DISABLED or UNAVAILABLE — never an invented verdict.
DEMO_MODE=false

ABUSEIPDB_API_KEY=
EMAILREP_API_KEY=
VIRUSTOTAL_API_KEY=

ABUSEIPDB_ENABLED=true
EMAILREP_ENABLED=true
VIRUSTOTAL_ENABLED=false

MAX_IP_LOOKUPS=10
MAX_DOMAIN_LOOKUPS=10
MAX_URL_LOOKUPS=5
MAX_EMAIL_LOOKUPS=3
INTEL_CACHE_TTL_SECONDS=3600
INTEL_TIMEOUT_SECONDS=8.0
INTEL_MAX_CONCURRENCY=8

# -- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=20/minute

# -- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET=

# Leave false. Headers contain recipient addresses, internal hostnames and routing
# detail; logging them defeats the point of not storing submissions.
LOG_RAW_HEADERS=false
